---
// Topic search ("talk finder"), conversational under the hood. Talks to /api/talk-finder (netlify/functions/talk-finder)
// and hands the finished talk idea to the speaking-inquiry form on the same page.
// Without JavaScript, or if the assistant fails, visitors are pointed to the form.
---

<div class="tf" id="talk-finder" data-state="idle">
  <h3 class="tf-title">Is there a talk for your audience?</h3>
  <p class="tf-intro">Search my speaking topics by describing your event. If a talk idea fits, you can send it to me along with your inquiry.</p>

  <noscript><p class="tf-fallback">The search needs JavaScript to run. You can tell me about your event in the <a href="#inquire">form below</a>.</p></noscript>

  <div class="tf-chat" hidden>
    <div class="tf-log" aria-live="polite" hidden></div>
    <form class="tf-input" autocomplete="off">
      <label for="tf-text" class="tf-sr">Search my speaking topics</label>
      <textarea id="tf-text" rows="3" maxlength="1500" placeholder="Describe your audience and what you want them to get out of the talk. For example: 200 nurse managers who need to help their staff build new skills."></textarea>
      <button type="submit" class="tf-send">Search</button>
    </form>
  </div>

  <template id="tf-card">
    <article class="tf-card">
      <span class="tf-card-kicker">Talk idea</span>
      <h4 class="tf-card-title"></h4>
      <p class="tf-card-sub"></p>
      <p class="tf-card-desc"></p>
      <p class="tf-card-list-intro">Your audience will walk away with:</p>
      <ul class="check-list tf-card-list"></ul>
      <button type="button" class="cta tf-use">Put this talk idea in the form below</button>
      <p class="tf-card-refine">Want to change something? Describe the change in the search box and you'll get a revised talk idea.</p>
    </article>
  </template>
</div>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };
  type Talk = {
    title?: string; subtitle?: string; description?: string; takeaways?: string[];
    format?: string; organization?: string; audience?: string; event_date?: string;
    location?: string; needs?: string;
  };

  const MAX_USER_TURNS = 10;
  const COPY = {
    error: "Sorry, the search isn't working right now. You can tell Josh about your event in the form below.",
    limit: 'The search has had too many requests in a short time. You can try again in a minute, or tell Josh about your event in the form below.',
    tooLong: 'That description is too long. Could you shorten it to a few sentences?',
    maxTurns: "You've reached the maximum number of searches for now. You can tell Josh about your event, and any talk idea you liked, in the form below.',
    inForm: 'Your talk idea is in the form below. Add your name and email, then press Send to reach Josh.',
    toForm: 'Go to the form',
  };

  const root = document.getElementById('talk-finder');
  const chat = root?.querySelector<HTMLElement>('.tf-chat');
  const log = root?.querySelector<HTMLElement>('.tf-log');
  const inputForm = root?.querySelector<HTMLFormElement>('.tf-input');
  const textarea = root?.querySelector<HTMLTextAreaElement>('#tf-text');
  const sendBtn = root?.querySelector<HTMLButtonElement>('.tf-send');
  const cardTpl = document.getElementById('tf-card') as HTMLTemplateElement | null;

  const messages: Msg[] = [];
  let busy = false;

  if (root && chat && log && inputForm && textarea && sendBtn && cardTpl) {
    chat.hidden = false;

    // Visible text is everything before the talk block; hide a partly streamed "<talk" tag too.
    const visibleText = (raw: string) => {
      let text = raw.replace('[[error]]', '');
      const tag = text.indexOf('<talk');
      if (tag !== -1) text = text.slice(0, tag);
      for (let n = 4; n > 0; n--) {
        if (text.endsWith('<talk'.slice(0, n))) { text = text.slice(0, -n); break; }
      }
      return text.trim();
    };

    const parseTalk = (raw: string): Talk | null => {
      const m = raw.match(/<talk>([\s\S]*?)<\/talk>/);
      if (!m) return null;
      try {
        const t = JSON.parse(m[1].trim());
        return t && typeof t.title === 'string' ? t : null;
      } catch {
        return null;
      }
    };

    const setParagraphs = (el: HTMLElement, text: string) => {
      el.replaceChildren(...text.split(/\n+/).filter(Boolean).map((line) => {
        const p = document.createElement('p');
        p.textContent = line;
        return p;
      }));
    };

    const addBubble = (role: Msg['role'], text = '') => {
      const div = document.createElement('div');
      div.className = `tf-msg tf-msg--${role === 'user' ? 'user' : 'bot'}`;
      setParagraphs(div, text);
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
      return div;
    };

    const addNotice = (text: string, withLink: boolean) => {
      const div = document.createElement('div');
      div.className = 'tf-msg tf-msg--bot tf-msg--notice';
      const p = document.createElement('p');
      p.textContent = text;
      div.appendChild(p);
      if (withLink) {
        const a = document.createElement('a');
        a.href = '#inquire';
        a.textContent = COPY.toForm;
        div.appendChild(a);
      }
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
    };

    const leadSummary = (t: Talk) => {
      const lines = [];
      if (t.needs) lines.push(`What they need: ${t.needs}`, '');
      lines.push(`Proposed talk: ${t.title}${t.subtitle ? `: ${t.subtitle}` : ''}`);
      if (t.description) lines.push(t.description);
      if (t.takeaways?.length) {
        lines.push('', 'Your audience will walk away with:', ...t.takeaways.map((x) => `- ${x}`));
      }
      if (t.format) lines.push('', `Format: ${t.format}`);
      return lines.join('\n');
    };

    // Fill the inquiry form, never overwriting what the visitor typed there themselves.
    const fill = (id: string, value?: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (!el || !value) return;
      if (el.value && el.dataset.tf !== '1') return;
      if (el instanceof HTMLSelectElement && ![...el.options].some((o) => o.value === value)) return;
      el.value = value;
      el.dataset.tf = '1';
    };

    const useTalk = (t: Talk) => {
      fill('f-org', t.organization);
      fill('f-aud', t.audience);
      fill('f-date', t.event_date);
      fill('f-loc', t.location);
      fill('f-format', t.format);
      const idea = document.getElementById('f-talk') as HTMLTextAreaElement | null;
      const ideaWrap = document.getElementById('f-talk-wrap');
      const source = document.getElementById('f-source') as HTMLInputElement | null;
      if (idea) idea.value = leadSummary(t);
      if (ideaWrap) ideaWrap.hidden = false;
      if (source) source.value = 'talk-finder';
      addNotice(COPY.inForm, false);
      document.getElementById('inquire')?.scrollIntoView({ behavior: 'smooth' });
      (document.getElementById('f-name') as HTMLInputElement | null)?.focus({ preventScroll: true });
    };

    const addCard = (t: Talk) => {
      const card = cardTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      card.querySelector('.tf-card-title')!.textContent = t.title || '';
      const sub = card.querySelector<HTMLElement>('.tf-card-sub')!;
      if (t.subtitle) sub.textContent = t.subtitle; else sub.remove();
      card.querySelector('.tf-card-desc')!.textContent = t.description || '';
      const list = card.querySelector('.tf-card-list')!;
      const takeaways = (t.takeaways || []).filter((x) => typeof x === 'string');
      if (takeaways.length) {
        takeaways.forEach((x) => { const li = document.createElement('li'); li.textContent = x; list.appendChild(li); });
      } else {
        card.querySelector('.tf-card-list-intro')?.remove();
        list.remove();
      }
      card.querySelector('.tf-use')!.addEventListener('click', () => useTalk(t));
      log.appendChild(card);
      log.scrollTop = log.scrollHeight;
    };

    const setBusy = (on: boolean) => {
      busy = on;
      sendBtn.disabled = on;
      root.dataset.state = on ? 'busy' : 'idle';
    };

    const userTurns = () => messages.filter((m) => m.role === 'user').length;

    const send = async (text: string) => {
      messages.push({ role: 'user', content: text });
      log.hidden = false;
      addBubble('user', text);
      setBusy(true);
      const bubble = addBubble('assistant');
      bubble.classList.add('tf-msg--typing');
      let raw = '';
      let failure: 'error' | 'limit' | 'tooLong' | null = null;

      try {
        const res = await fetch('/api/talk-finder', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages }),
        });
        if (!res.ok || !res.body) {
          failure = res.status === 429 ? 'limit' : res.status === 400 ? 'tooLong' : 'error';
        } else {
          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          for (;;) {
            const { done, value } = await reader.read();
            if (done) break;
            raw += decoder.decode(value, { stream: true });
            const shown = visibleText(raw);
            if (shown) { bubble.classList.remove('tf-msg--typing'); setParagraphs(bubble, shown); }
            log.scrollTop = log.scrollHeight;
          }
          if (raw.includes('[[error]]')) failure = 'error';
        }
      } catch {
        failure = 'error';
      }

      bubble.classList.remove('tf-msg--typing');
      const shown = visibleText(raw);
      if (!shown) bubble.remove();

      if (failure) {
        messages.pop(); // let the visitor try again without a dangling turn
        addNotice(COPY[failure], failure !== 'tooLong');
      } else {
        messages.push({ role: 'assistant', content: raw.trim() });
        const talk = parseTalk(raw);
        if (talk) addCard(talk);
        if (userTurns() >= MAX_USER_TURNS) {
          addNotice(COPY.maxTurns, true);
          textarea.disabled = true;
          sendBtn.disabled = true;
          return;
        }
      }
      setBusy(false);
      textarea.focus({ preventScroll: true });
    };

    inputForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = textarea.value.trim();
      if (!text || busy) return;
      textarea.value = '';
      send(text);
    });

    textarea.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        inputForm.requestSubmit();
      }
    });
  }
</script>

<style>
  .tf {
    margin-top: 3rem;
    scroll-margin-top: 90px;
  }
  .tf-title {
    font-size: 1.5rem;
  }
  .tf-chat[hidden],
  .tf-log[hidden] { display: none; }
  .tf-log {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 520px;
    overflow-y: auto;
    padding: 1.25rem;
    background: var(--color-gray-100);
    border: 1px solid var(--color-gray-200);
  }
  .tf-msg {
    max-width: 85%;
    padding: 0.75rem 1rem;
    border-radius: 14px;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .tf-msg :global(p) {
    margin: 0 0 0.5rem;
    color: inherit;
  }
  .tf-msg :global(p:last-child) { margin-bottom: 0; }
  .tf-msg--bot {
    align-self: flex-start;
    background: var(--color-white);
    color: var(--color-gray-800);
    border-bottom-left-radius: 4px;
  }
  .tf-msg--user {
    align-self: flex-end;
    background: var(--color-black);
    color: var(--color-white);
    border-bottom-right-radius: 4px;
    white-space: pre-wrap;
  }
  .tf-msg--notice a {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
  }
  .tf-msg--typing::after {
    content: '';
    display: inline-block;
    width: 2.25rem;
    height: 0.6rem;
    background: radial-gradient(circle, var(--color-gray-600) 35%, transparent 40%) 0 50% / 0.75rem 0.6rem repeat-x;
    animation: tf-dots 1s steps(3) infinite;
  }
  @keyframes tf-dots {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  .tf-input {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    margin-top: 0.75rem;
  }
  .tf-input textarea {
    min-height: 0;
    flex: 1;
    resize: none;
    font-size: 1rem;
  }
  .tf-send {
    padding: 0.9rem 1.75rem;
    background: var(--color-accent);
    color: var(--color-white);
    border: none;
    border-radius: 50px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .tf-send:disabled { opacity: 0.5; cursor: default; }
  .tf-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .tf-card {
    align-self: stretch;
    padding: 1.5rem;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-top: 4px solid var(--color-accent);
  }
  .tf-card-kicker {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .tf-card-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
  .tf-card-sub {
    font-family: var(--font-serif);
    font-style: italic;
    margin-bottom: 0.75rem;
  }
  .tf-card-desc { font-size: 0.95rem; }
  .tf-card-list-intro {
    margin-bottom: 0.5rem;
    color: var(--color-black);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .tf-card-list { font-size: 0.95rem; margin-bottom: 1.25rem; }
  .tf-use {
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .tf-card-refine {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
  }
  @media (max-width: 600px) {
    .tf-log { padding: 0.75rem; max-height: 460px; }
    .tf-msg { max-width: 92%; }
    .tf-input { flex-direction: column; align-items: stretch; }
    .tf-card { padding: 1.25rem; }
  }
</style>
