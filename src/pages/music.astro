---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import concertPlayingImg from '../assets/images/concert-playing-graded.jpg';
import wanderingsouthImg from '../assets/images/wanderingsouth.webp';
import chillgrassImg from '../assets/images/chillgrass.png';
import georgiajaysImg from '../assets/images/georgiajays.png';
import joshPortraitImg from '../assets/images/josh-portrait.jpg';
import brainjoLogoImg from '../assets/images/brainjo-logo.png';
---

<Layout title="Music | Josh Turknett" currentPage="music" description="Music as applied learning science. Performance, instruction, and the Brainjo method.">

  <!-- Hero -->
  <section class="hero-section" style="min-height: 70vh;">
    <div class="hero-bg">
      <Image src={concertPlayingImg} width={1920} widths={[800, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" alt="" data-parallax="0.3" />
    </div>
    <div class="hero-content">
      <h1 class="hero-title">Music</h1>
      <p class="hero-subtitle">I've played music most of my life. I perform with several bands, and I teach adults to play.</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="container">
      <div class="fade-in">
        <p class="statement statement--center">
          Music is where I test everything I teach about learning and the brain, in my own playing and in helping adults learn to play.
        </p>
      </div>
    </div>
  </section>

  <!-- Performance -->
  <section class="section section--gray">
    <div class="container">
      <h2 class="fade-in">Projects</h2>
      <div class="music-grid fade-in fade-in-delay-1">
        <a href="https://wanderingsouth.net/" target="_blank" rel="noopener" class="music-card">
          <div class="music-card-image">
            <Image src={wanderingsouthImg} width={800} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" alt="Wandering South" />
          </div>
          <div class="music-card-content">
            <h3>Wandering South</h3>
            <p>Have banjo, will travel. Original songs in the alt-country/Americana vein, with room to breathe and space to think.</p>
          </div>
        </a>
        <a href="https://thechillgrassproject.com/" target="_blank" rel="noopener" class="music-card">
          <div class="music-card-image">
            <Image src={chillgrassImg} width={800} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" alt="Chillgrass Project" />
          </div>
          <div class="music-card-content">
            <h3>Chillgrass Project</h3>
            <p>Like bluegrass, but more chill. Clawhammer banjo, slow tempos, and a front porch where everyone's welcome.</p>
          </div>
        </a>
        <a href="http://thegeorgiajays.com/" target="_blank" rel="noopener" class="music-card">
          <div class="music-card-image">
            <Image src={georgiajaysImg} width={800} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" alt="The Georgia Jays" />
          </div>
          <div class="music-card-content">
            <h3>The Georgia Jays</h3>
            <p>Old-time music with guts and pulse. A fiddle-banjo duo with Justin Manglitz, award-winning master distiller and fiddler.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Instruction with split -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split-content fade-in">
          <h2>Teaching</h2>
          <p class="lead">
            I teach music to adults, especially adults who think they missed their window. They didn't. The brain can learn to play music at any age.
          </p>
          <p>
            Most adults who struggle were never shown how to practice. When they change how they practice, they start making progress again.
          </p>
        </div>
        <div class="split-image framed fade-in fade-in-delay-1">
          <Image src={joshPortraitImg} width={1200} widths={[600, 900, 1200]} sizes="(max-width: 768px) 100vw, 50vw" alt="Josh Turknett with banjos" />
        </div>
      </div>
    </div>
  </section>

  <!-- Brainjo -->
  <section class="section section--gray">
    <div class="container">
      <div class="split split--reverse">
        <div class="split-image fade-in">
          <Image src={brainjoLogoImg} width={800} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" alt="Brainjo" style="object-fit: contain; padding: 2rem;" />
        </div>
        <div class="split-content fade-in fade-in-delay-1">
          <h2>Brainjo</h2>
          <p class="lead">Brainjo is the music-learning method I created. It's built on how the brain learns:</p>
          <ul class="check-list">
            <li>How to practice so new skills stick</li>
            <li>How to learn by ear</li>
            <li>How to get past the obstacles that make most adults quit</li>
          </ul>
          <p>Thousands of adults have used it to play music they were sure was out of reach.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container" style="text-align: center;">
      <div class="fade-in">
        <p class="statement statement--center" style="color: white; margin-bottom: 2rem;">A performance, a workshop, and a talk can all be part of the same event.</p>
        <a href="/speaking#inquire" class="cta">Get in touch</a>
      </div>
    </div>
  </section>

</Layout>
