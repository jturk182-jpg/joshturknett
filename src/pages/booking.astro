---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import pergola from '../assets/images/booking/josh-pergola.jpg';
import stage from '../assets/images/booking/josh-stage.jpg';
import banjos from '../assets/images/josh-portrait.jpg';

const clips = [
  { id: 'Rppy7MXm5sk', title: 'Hey There Delilah', note: 'The Plain White T\'s song, sung with clawhammer banjo.' },
  { id: '4edqh9-kzuU', title: 'Where Is My Mind?', note: 'The Pixies song, sung with clawhammer banjo.' },
  { id: 'YEYgymMIbQw', title: 'Darling Corey', note: 'A traditional Appalachian song on clawhammer banjo.' },
  { id: 'wJ2wrFjc7wA', title: 'Cider', note: 'An old-time banjo instrumental.' },
];

const styles = [
  { name: 'His own songs', how: 'Banjo or guitar, vocals', songs: 'Worked into each set, including songs he released with Wandering South.' },
  { name: 'Traditional folk songs', how: 'Banjo, vocals', songs: '“Tom Dooley,” “Bury Me Beneath the Willow,” “Wild Mountain Thyme,” “Man of Constant Sorrow,” “House of the Rising Sun,” “Darling Corey”' },
  { name: 'Old-time banjo instrumentals', how: 'Banjo and gourd banjo', songs: '“Cider,” “Soldier\'s Joy,” “Angelina Baker,” “Sandy Boys”' },
  { name: 'Favorites from the 70s, 80s and 90s', how: 'Banjo or guitar, vocals', songs: '“Where Is My Mind?” “Have You Ever Seen the Rain,” “Take Me Home, Country Roads,” “Time After Time,” plus “Desperado” and “Good Riddance” as banjo instrumentals' },
];

const photos = [
  { img: stage, file: '/booking/josh-turknett-stage.jpg', alt: 'Josh Turknett singing and playing banjo on stage' },
  { img: pergola, file: '/booking/josh-turknett-pergola.jpg', alt: 'Josh Turknett playing banjo outdoors' },
  { img: banjos, file: '/booking/josh-turknett-banjos.jpg', alt: 'Josh Turknett with a wall of banjos' },
];
---

<Layout title="Book a Show | Josh Turknett" currentPage="music" description="Book Josh Turknett for your winery, market, restaurant or brewery: banjo, guitar and songs, from traditional folk to favorites from the 70s, 80s and 90s.">

  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">Live music</span>
        <h1 class="page-hero-title">Book Josh Turknett</h1>
        <p class="hero-subtitle">Josh Turknett plays banjo and guitar and sings his own songs, traditional folk songs and favorites from the 70s, 80s and 90s.</p>
        <p class="booking-contact">Booking: <a href="mailto:booking@joshturknett.com">booking@joshturknett.com</a></p>
      </div>
      <div class="page-hero-photo">
        <Image src={stage} width={840} widths={[420, 840]} sizes="(max-width: 900px) 420px, 40vw" loading="eager" alt="Josh Turknett singing and playing banjo on stage" class="hero-stage" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>About Josh</h2>
      <p class="lead">Josh Turknett is a banjo player and singer based in Roswell, Georgia. His shows mix his own songs with traditional folk songs, old-time banjo instrumentals (some on a gourd banjo) and favorites from the 70s, 80s and 90s, on banjo and guitar. His banjo channels on YouTube have more than 50,000 subscribers, and the Brainjo Method he created has helped thousands of adults learn to play music.</p>
      <p class="lead">He is also a neurologist and four-time bestselling author. His latest book, <em>The Genius and the Impostor</em>, shows how extraordinary minds are built from ordinary brains.</p>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">
      <h2>Watch</h2>
      <p class="section-intro">Four solo clips: two contemporary songs sung with clawhammer banjo (a traditional style where the hand strikes down on the strings), a traditional song, and an old-time instrumental.</p>
      <div class="clip-grid">
        {clips.map((c) => (
          <figure class="clip">
            <div class="clip-frame">
              <iframe src={`https://www.youtube-nocookie.com/embed/${c.id}`} title={`${c.title}, Josh Turknett`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <figcaption><strong>{c.title}</strong><br />{c.note}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>What a set sounds like</h2>
      <p class="section-intro">A typical show runs two or three 45-minute sets and moves between four kinds of music.</p>
      <dl class="set-list">
        {styles.map((s) => (
          <div class="set-row">
            <dt>{s.name}<span>{s.how}</span></dt>
            <dd>{s.songs}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">
      <div class="split">
        <div class="split-content">
          <h2>Setup</h2>
          <p class="lead">Josh brings his own sound system, so the venue only needs a spot to play and a power outlet.</p>
          <ul class="check-list">
            <li><strong>Set length:</strong> two or three 45-minute sets, or one longer set for markets and brunch</li>
            <li><strong>Arrival:</strong> about 20 minutes to set up before the first set, and about 15 minutes to pack up after the last</li>
            <li><strong>Space:</strong> room for one performer, a speaker and an instrument stand, indoors or out</li>
            <li><strong>Volume:</strong> kept low enough for people to talk at their tables, and adjusted to the size of the room</li>
          </ul>
        </div>
        <div class="split-image">
          <Image src={pergola} width={1200} widths={[600, 900, 1200]} sizes="(max-width: 768px) 100vw, 50vw" alt="Josh Turknett playing banjo outdoors" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Getting the word out</h2>
      <p>Josh announces each booked show to his Instagram followers and lists it on his <a href="/events">events page</a>. Venues can share the post with their own followers and tag <a href="https://www.instagram.com/brainjojosh" target="_blank" rel="noopener">@brainjojosh</a> in their own posts.</p>

      <h2 class="listing-heading">Calendar listing</h2>
      <p>Paste either line into your events calendar.</p>
      <p class="listing"><strong>Short:</strong> Josh Turknett, banjo, guitar and songs</p>
      <p class="listing"><strong>Full:</strong> Josh Turknett plays banjo and guitar and sings his own songs, traditional folk songs and favorites from the 70s, 80s and 90s.</p>
    </div>
  </section>

  <section class="section section--gray">
    <div class="container">
      <h2 class="photos-heading">Photos</h2>
      <div class="photo-grid">
        {photos.map((p) => (
          <figure class="photo">
            <Image src={p.img} width={480} widths={[320, 480]} sizes="(max-width: 600px) 90vw, 320px" alt={p.alt} />
            <figcaption><a href={p.file} download aria-label={`Download ${p.alt}`}>Download</a></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container" style="text-align: center;">
      <p class="statement statement--center" style="color: white; margin-bottom: 1.5rem;">To book a show, send an email to booking@joshturknett.com.</p>
      <a href="mailto:booking@joshturknett.com" class="cta">booking@joshturknett.com</a>
    </div>
  </section>

</Layout>

<style>
  .booking-contact { margin-top: 1.5rem; font-size: 1.05rem; }
  .page-hero-photo :global(img.hero-stage) { object-fit: cover; object-position: 45% 30%; }
  .booking-contact a { overflow-wrap: anywhere; }
  .section-intro { margin-bottom: 2rem; max-width: 65ch; }
  .clip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }
  @media (min-width: 1000px) { .clip-grid { grid-template-columns: repeat(2, 1fr); max-width: 900px; } }
  .clip { margin: 0; }
  .clip-frame { position: relative; aspect-ratio: 16 / 9; background: var(--color-black); border-radius: 6px; overflow: hidden; }
  .clip-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .clip figcaption { margin-top: 0.75rem; line-height: 1.6; }
  .set-list { margin: 0; display: grid; gap: 1.5rem; }
  .set-row { display: grid; grid-template-columns: 15rem 1fr; gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-gray-200); }
  .set-row dt { font-weight: 600; }
  .set-row dt span { display: block; font-weight: 400; color: var(--color-gray-600); font-size: 0.9rem; margin-top: 0.25rem; }
  .set-row dd { margin: 0; line-height: 1.7; }
  .listing-heading { margin-top: 3rem; }
  .listing { background: var(--color-gray-100); padding: 0.9rem 1.1rem; border-radius: 6px; }
  .photos-heading { text-align: center; margin-bottom: 2rem; }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; max-width: 1000px; margin: 0 auto; }
  .photo { margin: 0; text-align: center; }
  .photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; display: block; border-radius: 6px; }
  .photo figcaption { margin-top: 0.75rem; font-size: 0.9rem; }
  @media (max-width: 700px) {
    .set-row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
