---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import joshStairsImg from '../assets/images/headshots/josh-stairs.jpg';
import bookGeniusImpostorImg from '../assets/images/book-genius-impostor.jpg';
import concertPlayingImg from '../assets/images/concert-playing.jpg';
import { retailers } from '../data/book';
---

<Layout title="Josh Turknett, MD | Neurologist, Speaker, and Author of The Genius and the Impostor" currentPage="home">

  <!-- Hero: book + speaking -->
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-text">
        <span class="eyebrow">Neurologist · Author · Speaker</span>
        <h1 class="home-hero-title">Extraordinary minds are built from ordinary brains.</h1>
        <p class="hero-subtitle">I'm a neurologist and a four-time bestselling author. My new book, <em>The Genius and the Impostor</em>, reveals two competing forces inside every brain. One is the source of your extraordinary capabilities. The other has spent your whole life trying to convince you they don't exist.</p>
        <div class="cta-row">
          <a href="#book" class="cta">Get the book</a>
          <a href="/speaking" class="cta cta--outline">Book a talk</a>
        </div>
        <p class="badge-line">A Next Big Idea Club Must-Read</p>
      </div>
      <div class="home-hero-visual">
        <Image src={joshStairsImg} width={900} widths={[480, 720, 900]} sizes="(max-width: 900px) 90vw, 45vw" loading="eager" fetchpriority="high" alt="Josh Turknett" class="home-hero-photo" />
        <a href="#book" class="home-hero-book" aria-label="The Genius and the Impostor">
          <Image src={bookGeniusImpostorImg} width={360} widths={[180, 360]} sizes="180px" loading="eager" alt="The Genius and the Impostor book cover" />
        </a>
      </div>
    </div>
  </section>

  <!-- Praise -->
  <section class="section section--gray praise-section">
    <div class="container">
      <div class="praise-grid">
        <figure class="praise-card fade-in">
          <blockquote>"The Genius and the Impostor challenges everything we think we know about intelligence, talent, and potential. A compelling invitation to rethink what's possible for your brain."</blockquote>
          <figcaption><strong>David Perlmutter</strong>Author of <em>Grain Brain</em></figcaption>
        </figure>
        <figure class="praise-card fade-in fade-in-delay-1">
          <blockquote>"A powerful reminder that extraordinary ability isn't reserved for a gifted few. Josh Turknett makes the science of human potential both fascinating and deeply inspiring."</blockquote>
          <figcaption><strong>Nelson Dellis</strong>Six-time USA Memory Champion</figcaption>
        </figure>
        <figure class="praise-card fade-in fade-in-delay-2">
          <blockquote>"Your brain is far more capable than you believe. Turknett's gift is showing you who's been writing the script, and handing you the pen."</blockquote>
          <figcaption><strong>Ben Rein</strong>Author of <em>Why Brains Need Friends</em></figcaption>
        </figure>
        <figure class="praise-card fade-in fade-in-delay-3">
          <blockquote>"As a physician, neuroscientist and somatic therapist who has studied the brain and emotion for 35 years, I rarely find a popular book on the subject that is actually fun to read. The Genius and the Impostor was."</blockquote>
          <figcaption><strong>Russell Kennedy, MD</strong></figcaption>
        </figure>
      </div>
      <div class="media-row fade-in">
        <span class="media-label">Interviewed on</span>
        <ul>
          <li>KERA Think</li>
          <li>STEM-Talk</li>
          <li>Next Big Idea Daily</li>
          <li>Musicality Now</li>
          <li>Bluegrass Jam Along</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Book -->
  <section class="section" id="book">
    <div class="container">
      <div class="split book-split">
        <div class="book-feature fade-in">
          <Image src={bookGeniusImpostorImg} width={600} widths={[300, 600]} sizes="(max-width: 768px) 70vw, 380px" alt="The Genius and the Impostor book cover" />
        </div>
        <div class="split-content fade-in fade-in-delay-1">
          <h2>The Genius and the Impostor</h2>
          <p class="book-subtitle">The Neuroscience of Unlocking Human Potential</p>
          <p>There are two forces at work inside every brain.</p>
          <p><strong>The Genius</strong> is the part of you that learns. It builds every skill you have, from walking and talking to whatever you're best at, and it runs those skills without you having to think about them.</p>
          <p><strong>The Impostor</strong> is the voice in your head that narrates your life. He's also a compulsive liar, and his masterpiece is the Special Brain Story: the idea that each of us is born with a certain kind of brain, and the brain you got decides what you can do.</p>
          <p class="list-intro">In the book, you'll learn:</p>
          <ul class="check-list">
            <li>How the Genius builds intelligence through learning</li>
            <li>Why the Impostor gets loudest when the stakes are highest</li>
            <li>How to quiet the Impostor so the Genius can do its work</li>
          </ul>
          <div class="retailers">
            {retailers.map((r) => (
              <a href={r.url} target="_blank" rel="noopener" class="retailer">{r.name}</a>
            ))}
          </div>
          <a href="/books" class="small-link">Also by Josh: <em>Anyone Can Play Music</em> →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Speaking -->
  <section class="image-section image-section--overlay">
    <Image src={concertPlayingImg} width={1920} widths={[800, 1280, 1920, 2560]} sizes="100vw" alt="" data-parallax="0.2" />
  </section>

  <section class="section section--gray">
    <div class="container">
      <div class="speaking-intro fade-in">
        <h2>Speaking</h2>
        <p class="lead">I speak to people whose work depends on learning and performing: business and HR leaders, educators, physicians and researchers, musicians, athletes, and coaches. I build every talk around the problems your audience is facing, and every keynote includes live music.</p>
      </div>
      <div class="talk-preview-grid">
        <a href="/speaking#genius-impostor" class="preview-card fade-in">
          <span class="card-kicker">Signature talk</span>
          <h3>The Genius and the Impostor</h3>
          <p>Why skilled people underperform when it matters most</p>
          <span class="preview-link">Read more →</span>
        </a>
        <a href="/speaking#special-brain" class="preview-card fade-in fade-in-delay-1">
          <span class="card-kicker">Signature talk</span>
          <h3>The Special Brain Story</h3>
          <p>What neuroscience says about talent</p>
          <span class="preview-link">Read more →</span>
        </a>
      </div>
      <div class="center fade-in">
        <a href="/speaking" class="cta">See talks and check availability</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="container narrow fade-in">
      <h2>About Josh</h2>
      <p class="lead">I'm a board-certified neurologist. The question that's driven most of my career is how the brain builds extraordinary skill, and why we so often underestimate what it can do.</p>
      <p>For years I've put what I've learned to work with thousands of adult music learners through Brainjo, the music-learning method I created. I founded the <a href="https://performanceneurology.institute" target="_blank" rel="noopener">Institute for Performance Neurology</a> to bring that work to leaders, educators, clinicians, athletes, and anyone else who has to perform when it counts.</p>
      <a href="/about" class="small-link">More about me →</a>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section section--dark" id="newsletter">
    <div class="container narrow center fade-in">
      <h2>Brains, Banjos &amp; Beyond</h2>
      <p class="lead">Every week I write about the brain, learning, and music for more than 50,000 readers. Join them.</p>
      <iframe src="https://joshturknett.substack.com/embed" title="Subscribe to Brains, Banjos & Beyond" class="substack-embed" frameborder="0" scrolling="no"></iframe>
    </div>
  </section>

</Layout>
