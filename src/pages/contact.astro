---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Josh Turknett" currentPage="contact" description="Get in touch with Josh Turknett about speaking, workshops, or live music at your event.">

  <!-- Hero -->
  <section class="section" style="padding-top: 160px;">
    <div class="container">
      <div class="fade-in">
        <h1>Get in touch</h1>
        <p class="lead" style="margin-top: 1.5rem;">For speaking, workshops, or live music at your event, tell me about it on the speaking inquiry form.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--gray">
    <div class="container" style="text-align: center;">
      <div class="fade-in">
        <a href="/speaking#inquire" class="cta">Open the inquiry form</a>
      </div>
    </div>
  </section>

</Layout>
