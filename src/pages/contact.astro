---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Josh Turknett" currentPage="contact" description="Inquire about speaking, workshops, music instruction, or integrated experiences.">

  <!-- Hero -->
  <section class="section" style="padding-top: 160px;">
    <div class="container">
      <div class="fade-in">
        <span class="hero-tagline">Contact</span>
        <h1>Let's talk.</h1>
        <p class="lead" style="margin-top: 1.5rem;">For speaking, workshops, music, or integrated experiences.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--gray">
    <div class="container" style="text-align: center;">
      <div class="fade-in">
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSepeh4_qQ-c7JIREBXz2arKyCH9RwFM0-7z7bNjH5roZF3WXQ/viewform" target="_blank" rel="noopener" class="cta">Open inquiry form</a>
      </div>
    </div>
  </section>

</Layout>
