---
// A one-page directory for places that allow only one link: the ClawhammerBanjo YouTube
// About section, a QR code at talks, guest bios, email signatures. (Instagram uses its own
// five-link menu instead.) Give each place its own address, e.g. /start?from=youtube or
// /start?from=talk. Every link on the page then carries that source: ?from= on this site
// (the forms record it) and utm_source= on the other sites (Substack and the Institute
// report it). With no ?from=, the source is "start".
// To feature something time-limited (a cohort class, a new event), set `show: true` on
// its entry, or add one at the top. Keep the list short: five or six links at most.
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import joshPorchImg from '../assets/images/headshots/josh-porch.jpg';

const utm = 'utm_source=start&utm_medium=link-page&utm_campaign=start';
const links = [
  { show: false, title: 'Free live class: [title], Nov 4', text: '[one line]', href: `https://performanceneurology.institute/pressure-gap?${utm}`, featured: true },
  { show: true, title: 'Get my free weekly newsletter', text: 'Brains, Banjos & Beyond: how the brain learns, music, and whatever I can’t stop thinking about.', href: `https://joshturknett.substack.com/subscribe?${utm}`, featured: true },
  { show: true, title: 'The Genius and the Impostor', text: 'My new book on how extraordinary minds are built from ordinary brains, plus free games and a map of its ideas.', href: `https://geniusandimpostor.com/?${utm}` },
  { show: true, title: 'What’s your Pressure Profile?', text: 'A free 3-minute quiz for musicians who play worse when it counts. Find out your type.', href: `https://performanceneurology.institute/pressure-profile?${utm}` },
  { show: true, title: 'Live events near you', text: 'Tell me where you live, and I’ll let you know if I’m putting on an event near you.', href: '/events?from=start#near-me' },
  { show: true, title: 'Book me to speak', text: 'Keynotes and workshops on learning, performance, and the brain.', href: '/speaking?from=start' },
].filter((l) => l.show);
---

<Layout title="Josh Turknett, MD" currentPage="" noindex={true} description="Neurologist Josh Turknett: the newsletter, the book, live events, and speaking.">
  <section class="start">
    <div class="start-inner">
      <div class="start-head">
        <Image src={joshPorchImg} width={240} widths={[120, 240]} sizes="120px" loading="eager" alt="Josh Turknett" class="start-photo" />
        <h1>Josh Turknett, MD</h1>
        <p>Neurologist and author of <em>The Genius and the Impostor</em></p>
      </div>
      <ul class="start-links">
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={['start-link', { 'start-link--featured': l.featured }]}>
              <span class="start-link-title">{l.title}</span>
              <span class="start-link-text">{l.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script is:inline>
    // Swap the default "start" source for the one in this page's address (?from=youtube).
    (function () {
      var from = (new URLSearchParams(location.search).get('from') || '').replace(/[^a-z0-9-]/gi, '').slice(0, 30);
      if (!from) return;
      document.querySelectorAll('a.start-link').forEach(function (a) {
        try {
          var u = new URL(a.getAttribute('href'), location.origin);
          if (u.searchParams.has('utm_source')) u.searchParams.set('utm_source', from);
          if (u.searchParams.has('from')) u.searchParams.set('from', from);
          a.setAttribute('href', u.origin === location.origin ? u.pathname + u.search + u.hash : u.href);
        } catch (e) {}
      });
    })();
  </script>
</Layout>

<style>
  .start { padding: 120px max(16px, env(safe-area-inset-right, 0px)) 80px max(16px, env(safe-area-inset-left, 0px)); }
  .start-inner { max-width: 560px; margin: 0 auto; }
  .start-head { text-align: center; margin-bottom: 2rem; }
  .start-head :global(.start-photo) { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto 1rem; display: block; }
  .start-head h1 { font-size: 1.6rem; margin-bottom: 0.35rem; }
  .start-head p { opacity: 0.75; margin: 0; }
  .start-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .start-link { display: block; padding: 1.1rem 1.25rem; border: 1px solid var(--color-gray-200); border-radius: 14px; background: var(--color-white); color: var(--color-black); text-decoration: none; transition: transform 0.15s ease, border-color 0.15s ease; }
  .start-link:hover { transform: translateY(-2px); border-color: var(--color-accent); }
  .start-link--featured { border-color: var(--color-accent); border-width: 2px; }
  .start-link-title { display: block; font-weight: 600; font-size: 1.05rem; margin-bottom: 0.25rem; }
  .start-link-text { display: block; font-size: 0.92rem; opacity: 0.75; line-height: 1.45; }
  @media (max-width: 600px) { .start { padding-top: 96px; } }
</style>
